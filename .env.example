# Documents form delivery (app/api/documents/route.ts)
# Provider: Resend (https://resend.com)

# Server-side only — never expose to the client, never commit real values.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account
# (Domains → Add Domain → add the DNS records Resend gives you), e.g.:
# CONTACT_FROM_EMAIL="NEOSURA Formular <formular@neosura.ch>"
CONTACT_FROM_EMAIL=

# Optional — defaults to info@neosura.ch if unset.
CONTACT_RECEIVER_EMAIL=info@neosura.ch
